{
  "name": "chatbotx",
  "version": "1.0.0",
  "description": "ChatbotX agentic workspace automation via CLI and MCP tools for contacts, conversations, flows, broadcasts, sequences, analytics, and omnichannel messaging.",
  "author": {
    "name": "ChatbotXIO",
    "email": "support@chatbotx.io"
  },
  "homepage": "https://chatbotx.io",
  "repository": "https://github.com/ChatbotXIO/chatbotx-agent",
  "license": "MIT-0",
  "logo": "assets/logo.svg",
  "keywords": [
    "chatbotx",
    "chatbot",
    "omnichannel",
    "messaging",
    "automation",
    "ai-agent",
    "mcp",
    "cli"
  ],
  "skills": [
    "./skills/chatbotx-cli",
    "./skills/chatbotx-mcp"
  ],
  "mcpServers": "./.cursor-plugin/mcp.json",
  "variables": {
    "type": "object",
    "properties": {
      "CHATBOTX_API_KEY": {
        "type": "string",
        "title": "ChatbotX API key",
        "description": "Workspace API key from ChatbotX Settings → Developer → API Keys."
      },
      "CHATBOTX_API_URL": {
        "type": "string",
        "title": "ChatbotX API URL",
        "description": "Base API URL, e.g. https://app.chatbotx.io/api."
      }
    },
    "required": ["CHATBOTX_API_KEY", "CHATBOTX_API_URL"]
  }
}
